{
  "name": "cherokhe/marketplace-integration-core",
  "description": "Framework-agnostic core orchestration package for marketplace integrations",
  "type": "library",
  "version": "2.0.0",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "psr/log": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "MarketplaceIntegrationCore\\Core\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MarketplaceIntegrationCore\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
