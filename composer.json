{
  "name": "marketplace/marketplace-integration-core-workspace",
  "description": "Workspace for marketplace-integration-core plus reference adapter and tests",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "psr/log": "^3.0"
  },
  "autoload": {
    "psr-4": {
