{
  "name": "cherokhe/marketplace-integration-core-workspace",
  "description": "Workspace for marketplace-integration-core plus reference adapter and tests",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.3",
    "cherokhe/marketplace-integration-core": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "psr/log": "^3.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "packages/marketplace-integration-core",
      "options": {
        "symlink": true
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "MarketplaceIntegrationCore\\Adapters\\": "adapters/",
      "MarketplaceIntegrationCore\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
